<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
    <Title>$(AssemblyName)</Title>
    <Authors>William Santos</Authors>
    <PackageId>VolcanoBlue.EventSourcing</PackageId>
    <Description>Event sourcing library with Models and EF Core.</Description>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageProjectUrl>https://volcano.blue</PackageProjectUrl>
    <RepositoryUrl>https://github.com/volcanoblue/event-sourcing</RepositoryUrl>
    <Copyright>2026 Volcano Blue</Copyright>
    <PackageIcon>Resources\icon.png</PackageIcon>
    <PackageTags>event sourcing;event-sourcing;events;cqrs;csharp-library</PackageTags>
    <PackageReadmeFile>Resources\README.md</PackageReadmeFile>
    <PackageVersion>4.0.0</PackageVersion>
    <Company>Volcano Blue</Company>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VolcanoBlue.EventSourcing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>Resources</PackagePath>
      <Visible>False</Visible>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>Resources</PackagePath>
      <Visible>False</Visible>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>Resources</PackagePath>
      <Visible>False</Visible>
    </None>
  </ItemGroup>

</Project>
